# Copy to apps/web/.env.local. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# USCIS I-765 filing fee in cents (as of 2026 pack). Not a live USCIS feed.
I765_FEE_CENTS=52000

# Bearer token for /api/cron/digest
CRON_SECRET=

# Public site URL for sitemap, robots, and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
